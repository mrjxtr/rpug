package components

import "github.com/mrjxtr/rpug/internal/generator"

templ PinoysTable(resp *generator.PinoyResponse) {
	<div id="pinoy-results">
		if resp == nil || resp.Results == nil || len(*resp.Results) == 0 {
			<p class="text-neutral-400 italic text-center py-8">No results.</p>
		} else {
			@templ.JSONScript("pinoy-json", resp)
			<button
				type="button"
				hx-on:click="navigator.clipboard.writeText(document.getElementById('pinoy-json').textContent).then(() => { const s = this.querySelector('span'); s.textContent = 'COPIED!'; setTimeout(() => s.textContent = 'COPY AS JSON', 1500) })"
				class="inline-flex w-fit items-center gap-2 px-3 py-1.5 bg-neutral-900 hover:bg-neutral-800 text-white font-semibold rounded-lg transition text-xs mb-2"
			>
				<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M7.5 3H14.6C16.8402 3 17.9603 3 18.816 3.43597C19.5686 3.81947 20.1805 4.43139 20.564 5.18404C21 6.03969 21 7.15979 21 9.4V16.5M6.2 21H14.3C15.4201 21 15.9802 21 16.408 20.782C16.7843 20.5903 17.0903 20.2843 17.282 19.908C17.5 19.4802 17.5 18.9201 17.5 17.8V9.7C17.5 8.57989 17.5 8.01984 17.282 7.59202C17.0903 7.21569 16.7843 6.90973 16.408 6.71799C15.9802 6.5 15.4201 6.5 14.3 6.5H6.2C5.0799 6.5 4.51984 6.5 4.09202 6.71799C3.71569 6.90973 3.40973 7.21569 3.21799 7.59202C3 8.01984 3 8.57989 3 9.7V17.8C3 18.9201 3 19.4802 3.21799 19.908C3.40973 20.2843 3.71569 20.5903 4.09202 20.782C4.51984 21 5.0799 21 6.2 21Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				<span>COPY AS JSON</span>
			</button>
			<div class="overflow-x-auto rounded-lg border border-neutral-800">
				<table class="w-full text-sm text-left border-collapse">
					<thead class="bg-neutral-800 text-neutral-100">
						<tr>
							<th class="px-4 py-3 font-semibold">#</th>
							<th class="px-4 py-3 font-semibold">Name</th>
							<th class="px-4 py-3 font-semibold">Gender</th>
							<th class="px-4 py-3 font-semibold">Age</th>
							<th class="px-4 py-3 font-semibold">Location</th>
							<th class="px-4 py-3 font-semibold">Phone</th>
							<th class="px-4 py-3 font-semibold">Email</th>
						</tr>
					</thead>
					<tbody class="text-neutral-200 bg-neutral-900">
						for i, p := range *resp.Results {
							<tr class="border-t border-neutral-800 hover:bg-neutral-800">
								<td class="px-4 py-3 text-neutral-500">{ i + 1 }</td>
								<td class="px-4 py-3">{ p.Name.Title } { p.Name.First } { p.Name.Last }</td>
								<td class="px-4 py-3 capitalize">{ p.Gender }</td>
								<td class="px-4 py-3">{ p.DOB.Age }</td>
								<td class="px-4 py-3">{ p.Location.City }, { p.Location.Region }</td>
								<td class="px-4 py-3 font-mono text-xs">{ p.Phone }</td>
								<td class="px-4 py-3">{ p.Email }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
