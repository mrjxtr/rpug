package layout

templ Layout(contents templ.Component, title string) {
	<!DOCTYPE html>
	<html lang="en">
		@header(title)
		<body class="flex flex-col min-h-screen bg-neutral-950">
			@navbar()
			<main class="flex-1 container mx-auto px-10 py-10">
				@contents
			</main>
			@footer()
			<script src="/static/js/htmx.min.js" type="text/javascript"></script>
		</body>
	</html>
}

templ header(title string) {
	<head>
		<title>{ title }</title>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<link rel="stylesheet" href="/static/css/styles.css"/>
	</head>
}

templ footer() {
	<footer class="border-t border-neutral-800 pt-3 pb-6">
		<div class="container mx-auto px-10 flex items-center justify-between gap-4 text-sm text-neutral-400">
			<div class="space-y-1 xl:pl-10 2xl:pl-32">
				<div>&copy; 2026 JESTER LUMACAD</div>
				<div>
					<a
						href="https://github.com/mrjxtr/rpug/blob/main/LICENSE"
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-white hover:underline"
					>LICENSE &middot; GPL-3.0</a>
				</div>
			</div>
			<a
				href="https://github.com/mrjxtr"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 text-white hover:underline xl:pr-10 2xl:pr-32 text-lg"
			>
				{ "@mrjxtr" }
				<svg class="w-5 h-5 shrink-0" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
				</svg>
			</a>
		</div>
	</footer>
}

templ navbar() {
	<nav></nav>
}
